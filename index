<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Robot Gathering — LOOK · COMPUTE · MOVE</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{
  box-sizing:border-box;
  margin:0;
  padding:0
}

:root{
  --bg:#F4F6FA;
  --bg2:#FFFFFF;
  --bg3:#EDF1F7;
  --bg4:#E1E7F0;
  --bg5:#D1D9E6;

  --border:#D6DEEA;
  --border2:#C1CCE0;
  --border3:#9FAFCB;

  --leader:#0E7C7B;
  --leader-mid:#14A3A1;
  --leader-light:#E3F6F5;
  --leader-glow:rgba(14,124,123,0.25);

  --follower:#6D28D9;
  --follower-light:#F1EAFE;

  --target:#D6455D;
  --target-light:#FDECEF;

  --coral:#E2653A;
  --coral-light:#FCEEE6;

  --teal:#0E7C7B;

  --amber:#C98A12;
  --amber-light:#FBF1DE;

  --green:#3F7D20;
  --green-light:#EDF6E3;

  --text:#1A1D2E;
  --text2:#3A4070;
  --text3:#7880AA;
  --text4:#B0B8D8;

  --shadow-sm:0 1px 4px rgba(14,124,123,0.08);
  --shadow-md:0 4px 16px rgba(14,124,123,0.12);
  --shadow-lg:0 12px 40px rgba(14,124,123,0.16);

  --cell:72px;

  --radius:8px;
  --radius-lg:12px;
  --radius-xl:20px;

  --font-mono:'JetBrains Mono',monospace;
  --font-ui:'Inter',sans-serif;
}

html,body{
  width:100%;
  height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-ui);
  font-size:14px;
  overflow:hidden
}

/* =========================================================
   APP SHELL
   ========================================================= */

.app{
  display:grid;
  grid-template-columns:1fr 316px;
  grid-template-rows:54px 1fr auto;
  height:100vh;
  min-height:0;
}

/* =========================================================
   TOPBAR
   ========================================================= */

.topbar{
  grid-column:1/-1;
  grid-row:1;

  background:var(--bg2);
  border-bottom:1.5px solid var(--border);

  display:flex;
  align-items:center;

  padding:0 18px;
  gap:14px;

  z-index:40;
  flex-shrink:0;

  box-shadow:var(--shadow-sm);
}

.topbar-brand{
  display:flex;
  align-items:center;
  gap:10px;
  flex-shrink:0
}

.brand-icon{
  width:34px;
  height:34px;
  background:var(--leader);
  border-radius:9px;

  display:flex;
  align-items:center;
  justify-content:center;

  flex-shrink:0;

  box-shadow:0 2px 8px rgba(14,124,123,0.35)
}

.brand-title{
  font-size:14px;
  font-weight:700;
  letter-spacing:0.01em;
  line-height:1.2;
  color:var(--text)
}

.brand-title span{
  color:var(--leader)
}

.brand-sub{
  font-size:9px;
  color:var(--text3);
  letter-spacing:0.1em;
  font-family:var(--font-mono)
}

.topbar-sep{
  width:1px;
  height:22px;
  background:var(--border);
  flex-shrink:0
}

.topbar-keys{
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;

  font-size:11px;
  color:var(--text3)
}

.topbar-keys kbd{
  background:var(--bg3);
  border:1px solid var(--border2);
  border-radius:4px;

  padding:1px 7px;

  color:var(--text2);
  font-family:var(--font-mono);
  font-size:10px;

  box-shadow:0 1px 0 var(--border2)
}

.topbar-keys span{
  color:var(--text4);
  margin-right:2px
}

.topbar-right{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:8px
}

.case-tag{
  font-size:10px;
  font-weight:700;

  padding:3px 11px;

  border-radius:20px;

  background:var(--leader-light);
  color:var(--leader);

  border:1px solid rgba(14,124,123,0.3);

  white-space:nowrap;

  font-family:var(--font-mono)
}

.icon-btn{
  width:32px;
  height:32px;

  border-radius:7px;
  border:1px solid var(--border2);

  background:transparent;
  color:var(--text3);

  cursor:pointer;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:14px;

  transition:all 0.15s
}

.icon-btn:hover{
  background:var(--bg3);
  color:var(--text);
  border-color:var(--border3)
}

/* =========================================================
   CONFIG DRAWER
   ========================================================= */

.config-overlay{
  display:none;

  position:fixed;
  inset:0;

  background:rgba(26,29,46,0.25);

  z-index:60;

  backdrop-filter:blur(3px)
}

.config-overlay.show{
  display:block
}

.config-drawer{
  position:fixed;

  top:0;
  right:-340px;

  width:322px;
  height:100vh;

  background:var(--bg2);

  border-left:1.5px solid var(--border2);

  z-index:70;

  transition:right 0.3s cubic-bezier(.4,0,.2,1);

  display:flex;
  flex-direction:column;

  box-shadow:-6px 0 24px rgba(14,124,123,0.1)
}

.config-drawer.open{
  right:0
}

.cfg-header{
  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:16px 18px;

  border-bottom:1px solid var(--border)
}

.cfg-title{
  font-size:13px;
  font-weight:600;
  color:var(--text)
}

.cfg-body{
  flex:1;
  overflow-y:auto;

  padding:16px 18px;

  display:flex;
  flex-direction:column;

  gap:14px
}

.cfg-field{
  display:flex;
  flex-direction:column;
  gap:5px
}

.cfg-field label{
  font-size:11px;
  color:var(--text2);
  font-weight:500;

  display:flex;
  align-items:center;

  gap:6px
}

.cfg-hint{
  font-size:9px;
  color:var(--text3);
  font-family:var(--font-mono)
}

.cfg-input,
.cfg-textarea{
  background:var(--bg3);

  border:1.5px solid var(--border2);

  color:var(--text);

  border-radius:7px;

  padding:8px 11px;

  font-family:var(--font-mono);
  font-size:12px;

  width:100%;

  transition:border-color 0.2s,box-shadow 0.2s
}

.cfg-input:focus,
.cfg-textarea:focus{
  outline:none;

  border-color:var(--leader);

  box-shadow:0 0 0 3px var(--leader-glow)
}

.cfg-textarea{
  resize:vertical;
  min-height:100px
}

.cfg-note{
  font-size:10px;
  color:var(--teal);

  margin-top:2px;

  font-style:italic
}

.cfg-actions{
  display:flex;
  flex-direction:column;
  gap:7px
}

.cfg-full{
  width:100%
}

.cfg-quick-sizes{
  display:flex;
  gap:6px;
  margin-top:2px
}

.cfg-quick-sizes button{
  flex:1;
  padding:6px 0;
  font-size:11px
}

.cfg-quick-sizes button.active-size{
  background:var(--leader);
  border-color:var(--leader);
  color:#fff
}

/* NEW CONFIG CHOICES */

.cfg-choice-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px
}

.cfg-choice{
  display:flex;
  align-items:center;
  gap:7px;

  padding:8px 10px;

  background:var(--bg3);

  border:1.5px solid var(--border2);

  border-radius:7px;

  cursor:pointer;

  font-size:11px;
  color:var(--text2);

  transition:all 0.15s
}

.cfg-choice:hover{
  border-color:var(--border3);
  background:var(--bg2)
}

.cfg-choice input{
  margin:0;
  accent-color:var(--leader)
}

.cfg-choice.selected{
  border-color:var(--leader);
  background:var(--leader-light);
  color:var(--leader);
  font-weight:600
}

.cfg-inline-note{
  font-size:9px;
  color:var(--text3);
  font-family:var(--font-mono);
  line-height:1.4
}

.cfg-trials{
  background:var(--amber-light);
  border-color:#E8C875
}

.cfg-trials:focus{
  border-color:var(--amber)
}

/* =========================================================
   GRID PANEL
   ========================================================= */

.grid-panel{
  grid-column:1;
  grid-row:2;

  display:flex;
  flex-direction:column;

  background:var(--bg);

  min-height:0;

  position:relative;
  overflow:hidden
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar{
  grid-column:2;
  grid-row:2;

  background:var(--bg2);

  border-left:1.5px solid var(--border);

  overflow-y:auto;

  display:flex;
  flex-direction:column;

  min-height:0
}

/* =========================================================
   REPLAY BAR
   ========================================================= */

.replay-bar{
  grid-column:1/-1;
  grid-row:3;

  background:var(--bg2);

  border-top:1.5px solid var(--border2);

  display:none;

  align-items:center;
  gap:10px;

  padding:7px 18px;

  flex-shrink:0;

  box-shadow:0 -2px 8px rgba(14,124,123,0.06)
}

.replay-bar.show{
  display:flex
}

/* =========================================================
   GRID HEADER
   ========================================================= */

.grid-header{
  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:11px 18px;

  border-bottom:1.5px solid var(--border);

  flex-shrink:0;

  gap:12px;

  background:var(--bg2)
}

.grid-header-right{
  display:flex;
  gap:16px
}

.mini-stat{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:1px
}

.mini-stat span{
  font-size:17px;
  font-weight:700;

  font-family:var(--font-mono);

  color:var(--text);

  line-height:1
}

.mini-stat label{
  font-size:9px;
  color:var(--text3);

  text-transform:uppercase;

  letter-spacing:0.07em
}

.grid-scroll{
  flex:1;
  overflow:auto;
  min-width:0;
  min-height:0;
  display:flex;
  align-items:flex-start;
  justify-content:flex-start;
  padding:20px;
}

.grid-outer{
  display:flex;
  flex-direction:column;
  gap:4px;
  align-items:flex-start;
  width:max-content;
  min-width:max-content;
}

.col-labels{
  display:flex;
  padding-left:28px;
  width: max-content;
}

.col-label{
  width:var(--cell);

  text-align:center;

  font-size:10px;

  color:var(--text3);

  font-family:var(--font-mono);

  padding-bottom:4px
}

.grid-body{
  display:flex;
  gap:6px;
  width:max-content;
  min-width:max-content;

}

.row-labels{
  display:flex;
  flex-direction:column;
  width:28px
}

.row-label{
  height:var(--cell);

  display:flex;
  align-items:center;
  justify-content:flex-end;

  font-size:10px;

  color:var(--text3);

  font-family:var(--font-mono);

  padding-right:6px;

  margin:1.5px 0
}

.grid{
  display:grid;
  grid-template-columns:repeat(var(--cols,4),var(--cell));
  gap:3px;
  background:var(--bg3);
  border:1.5px solid var(--border2);
  border-radius:var(--radius-lg);
  padding:3px;
  box-shadow:var(--shadow-md);
  width:max-content;
  min-width:max-content;
}

/* =========================================================
   CELLS
   ========================================================= */

.cell{
  width:var(--cell);
  height:var(--cell);

  background:var(--bg2);

  border:1.5px solid var(--border);

  border-radius:7px;

  position:relative;

  display:flex;
  align-items:center;
  justify-content:center;

  overflow:hidden;

  transition:
    background 0.3s,
    border-color 0.25s,
    box-shadow 0.25s;

  cursor:default
}

.cell.c-visited{
  background:#EAF0F7;
  border-color:var(--border2)
}

.cell.c-target{
  background:var(--target-light);

  border:2px solid var(--target);

  box-shadow:
    0 0 10px rgba(214,69,93,0.2)
}

.cell.c-leader{
  background:var(--leader-light);

  border:2px solid var(--leader-mid);

  box-shadow:
    0 0 12px var(--leader-glow)
}

.cell.c-stuck{
  background:var(--coral-light);

  border:2px solid var(--coral);

  box-shadow:
    0 0 10px rgba(226,101,58,0.2)
}

.cell.c-highlight{
  background:var(--leader-light);
  border:2px solid var(--leader-mid)
}

@keyframes ff{
  0%{
    background:var(--leader-light)
  }

  100%{
    background:var(--bg2)
  }
}

@keyframes fb{
  0%{
    background:var(--coral-light)
  }

  100%{
    background:var(--bg2)
  }
}

@keyframes fa{
  0%{
    background:var(--follower-light)
  }

  100%{
    background:var(--bg2)
  }
}

.flash-fwd{
  animation:ff 0.7s ease-out
}

.flash-back{
  animation:fb 0.7s ease-out
}

.flash-attach{
  animation:fa 0.7s ease-out
}

.wb-num{
  position:absolute;

  top:3px;
  left:5px;

  font-size:11px;
  font-weight:700;

  font-family:var(--font-mono);

  color:var(--text4);

  line-height:1;

  pointer-events:none;

  display:flex;
  align-items:baseline;

  gap:3px
}

.wb-num .wb-parent-tag{
  font-size:8px;
  font-weight:600;

  color:var(--follower);

  opacity:0.85
}

.cell.c-visited .wb-num{
  color:var(--leader-mid)
}

.cell.c-target .wb-num{
  color:var(--target)
}

.cell.c-leader .wb-num{
  color:var(--leader)
}

/* =========================================================
   ELECTION PANEL
   ========================================================= */

.election-panel{
  border-radius:9px;

  padding:10px 11px;

  border:1.5px solid var(--border2);

  background:var(--bg3);

  transition:
    background 0.3s,
    border-color 0.3s
}

.election-panel.active{
  background:var(--leader-light);

  border-color:var(--leader-mid);

  box-shadow:
    0 0 0 3px var(--leader-glow)
}

.election-panel-title{
  display:flex;
  align-items:center;

  gap:6px;

  font-size:10px;
  font-weight:700;

  color:var(--text2);

  margin-bottom:7px
}

.election-panel-title .dot{
  width:6px;
  height:6px;

  border-radius:50%;

  background:var(--text4)
}

.election-panel.active
.election-panel-title
.dot{
  background:var(--leader);

  animation:
    election-pulse 1.1s ease-in-out infinite
}

.election-panel.active
.election-panel-title{
  color:var(--leader)
}

.election-candidates{
  display:flex;
  flex-wrap:wrap;

  gap:6px
}

.election-chip{
  display:flex;
  align-items:center;

  gap:5px;

  padding:3px 9px;

  border-radius:20px;

  font-family:var(--font-mono);

  font-size:10px;

  font-weight:700;

  background:var(--bg2);

  border:1.5px solid var(--border2);

  color:var(--text2)
}

.election-panel.active
.election-chip{
  border-color:var(--leader-mid);

  color:var(--leader);

  background:var(--leader-light)
}

.election-chip .chip-id{
  width:16px;
  height:16px;

  border-radius:50%;

  background:var(--leader);

  color:#fff;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:8px
}

.election-empty{
  font-size:10px;
  color:var(--text3);
  font-style:italic
}

.election-winner-line{
  margin-top:8px;

  padding-top:8px;

  border-top:1px dashed var(--border2);

  font-size:10px;

  color:var(--follower);

  font-weight:600;

  display:none
}

.election-panel.decided
.election-winner-line{
  display:block
}

.visit-badge{
  position:absolute;

  bottom:3px;
  left:5px;

  font-size:8px;
  font-weight:700;

  font-family:var(--font-mono);

  color:var(--text4);

  line-height:1;

  pointer-events:none;

  letter-spacing:0.02em
}

.visit-badge.multi-visit{
  color:var(--amber)
}

.cell-coord{
  position:absolute;

  bottom:2px;
  right:4px;

  font-size:8px;

  color:var(--text4);

  font-family:var(--font-mono);

  opacity:0.7;

  pointer-events:none
}

.cell-content{
  display:flex;

  flex-direction:column;

  align-items:center;
  justify-content:center;

  gap:1px;

  z-index:2;

  pointer-events:none
}

/* =========================================================
   ELECTION TOOLTIP BADGE
   ========================================================= */

.election-badge{
  position:absolute;

  top:3px;
  right:4px;

  z-index:6;

  font-size:9px;
  font-weight:700;

  font-family:var(--font-mono);

  color:var(--leader);

  background:var(--leader-light);

  border:1px solid var(--leader-mid);

  border-radius:9px;

  padding:1px 6px;

  pointer-events:auto;

  cursor:help;

  animation:
    election-pulse 1.1s ease-in-out infinite;

  white-space:nowrap
}

@keyframes election-pulse{
  0%,100%{
    box-shadow:0 0 0 0 var(--leader-glow)
  }

  50%{
    box-shadow:0 0 0 4px var(--leader-glow)
  }
}

/* =========================================================
   ROBOTS
   ========================================================= */

.robot-wrap{
  display:flex;

  flex-direction:column;

  align-items:center;

  gap:1px
}

.robot-icon{
  width:38px;
  height:38px;

  display:flex;

  align-items:center;
  justify-content:center
}

.robot-icon svg{
  width:100%;
  height:100%
}

.robot-sub{
  font-size:8px;

  font-family:var(--font-mono);

  color:var(--text3);

  letter-spacing:0.04em;

  white-space:nowrap
}

@keyframes pop-in{
  from{
    transform:scale(0.3);
    opacity:0
  }

  to{
    transform:scale(1);
    opacity:1
  }
}

@keyframes pulse-leader{
  0%,100%{
    filter:drop-shadow(0 0 4px rgba(14,124,123,0.5))
  }

  50%{
    filter:drop-shadow(0 0 10px rgba(14,124,123,0.8))
  }
}

@keyframes pulse-target{
  0%,100%{
    filter:drop-shadow(0 0 4px rgba(214,69,93,0.4))
  }

  50%{
    filter:drop-shadow(0 0 10px rgba(214,69,93,0.7))
  }
}

.anim-pop{
  animation:
    pop-in 0.35s cubic-bezier(.34,1.56,.64,1)
}

.anim-leader{
  animation:
    pulse-leader 2s ease-in-out infinite
}

.anim-target{
  animation:
    pulse-target 2.5s ease-in-out infinite
}

/* =========================================================
   LEADER FLASH
   ========================================================= */

.leader-flash-overlay{
  display:none;

  position:absolute;
  inset:0;

  z-index:50;

  background:rgba(244,246,250,0.88);

  align-items:center;
  justify-content:center;

  pointer-events:none
}

.leader-flash-overlay.show{
  display:flex;

  animation:
    flash-fade 1.8s ease-out forwards
}

@keyframes flash-fade{
  0%{
    opacity:0
  }

  15%{
    opacity:1
  }

  70%{
    opacity:1
  }

  100%{
    opacity:0
  }
}

.torch-container{
  display:flex;

  flex-direction:column;

  align-items:center;

  gap:12px
}

.torch-flame{
  width:48px;
  height:64px;

  position:relative
}

.torch-flame::before{
  content:'';

  position:absolute;

  bottom:0;
  left:50%;

  transform:translateX(-50%);

  width:32px;
  height:48px;

  background:
    radial-gradient(
      ellipse at bottom,
      #fbbf24,
      #f59e0b,
      #d97706
    );

  border-radius:50% 50% 40% 40%;

  animation:
    flicker 0.4s ease-in-out infinite alternate
}

.torch-flame::after{
  content:'';

  position:absolute;

  bottom:8px;
  left:50%;

  transform:translateX(-50%);

  width:18px;
  height:32px;

  background:
    radial-gradient(
      ellipse at bottom,
      #fff7ed,
      #fde68a
    );

  border-radius:50% 50% 40% 40%;

  animation:
    flicker 0.3s ease-in-out infinite alternate-reverse
}

@keyframes flicker{
  0%{
    transform:
      translateX(-50%)
      scaleX(1)
      scaleY(1)
  }

  100%{
    transform:
      translateX(-50%)
      scaleX(0.92)
      scaleY(1.06)
  }
}

.torch-text{
  font-size:18px;

  font-weight:700;

  color:#92400E;

  font-family:var(--font-mono);

  letter-spacing:0.06em;

  text-align:center
}

/* =========================================================
   EVENT BANNER
   ========================================================= */

.event-banner{
  display:flex;

  align-items:flex-start;

  gap:10px;

  padding:10px 18px;

  background:var(--bg2);

  border-top:1.5px solid var(--border);

  flex-shrink:0;

  min-height:44px;

  box-shadow:
    0 -1px 0 var(--border)
}

.event-icon{
  width:22px;
  height:22px;

  border-radius:50%;

  background:var(--leader-light);

  border:1.5px solid rgba(14,124,123,0.3);

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:11px;
  font-weight:700;

  color:var(--leader);

  flex-shrink:0;

  font-family:var(--font-mono)
}

.event-text{
  font-size:11px;

  color:var(--text2);

  line-height:1.5;

  font-family:var(--font-mono);

  flex:1;

  word-break:break-word
}

/* =========================================================
   PHASE BADGE
   ========================================================= */

.phase-badge{
  display:flex;

  align-items:center;

  gap:8px;

  padding:6px 14px;

  border-radius:20px;

  font-size:11px;

  font-weight:600;

  font-family:var(--font-mono);

  border:1.5px solid transparent;

  transition:all 0.3s
}

.phase-dot{
  width:7px;
  height:7px;

  border-radius:50%;

  flex-shrink:0;

  animation:
    blink 1.6s ease-in-out infinite
}

@keyframes blink{
  0%,100%{
    opacity:1
  }

  50%{
    opacity:0.15
  }
}

/* =========================================================
   SIDEBAR BLOCKS
   ========================================================= */

.sb-block{
  padding:13px 15px;

  border-bottom:1px solid var(--border);

  flex-shrink:0
}

.sb-label{
  font-size:9px;

  font-weight:700;

  letter-spacing:0.12em;

  text-transform:uppercase;

  color:var(--text3);

  margin-bottom:9px;

  display:flex;

  align-items:center;

  gap:6px
}

.sb-label-hint{
  font-size:9px;

  font-weight:400;

  color:var(--text4);

  letter-spacing:0.04em;

  text-transform:none
}

/* =========================================================
   CONTROLS
   ========================================================= */

.ctrl-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:7px;

  margin-bottom:7px
}

.btn{
  display:flex;

  align-items:center;
  justify-content:center;

  gap:5px;

  padding:8px 10px;

  border:1.5px solid var(--border2);

  background:var(--bg2);

  color:var(--text);

  font-family:var(--font-ui);

  font-size:12px;

  font-weight:500;

  border-radius:7px;

  cursor:pointer;

  transition:all 0.15s;

  white-space:nowrap;

  box-shadow:var(--shadow-sm)
}

.btn:hover{
  background:var(--bg3);
  border-color:var(--border3)
}

.btn:active{
  transform:scale(0.96)
}

.btn:disabled{
  opacity:0.35;

  cursor:not-allowed;

  box-shadow:none
}

.btn-primary{
  background:var(--leader);

  border-color:var(--leader);

  color:#fff;

  box-shadow:
    0 2px 10px
    rgba(14,124,123,0.3)
}

.btn-primary:hover{
  background:#0A6362;
  border-color:#0A6362
}

.btn-play{
  background:var(--bg2)
}

.btn-play.active{
  background:var(--follower-light);

  border-color:var(--follower);

  color:var(--follower)
}

.btn-danger{
  background:#FDF0F1;

  border-color:#F0AEB8;

  color:var(--target)
}

.btn-danger:hover{
  background:var(--target-light)
}

.btn-run{
  background:var(--green-light);

  border-color:var(--green);

  color:var(--green);

  width:100%;

  margin-bottom:8px
}

.btn-run:hover{
  background:#DCEDC4
}

.speed-row{
  display:flex;

  align-items:center;

  gap:8px
}

.speed-lbl{
  font-size:10px;

  color:var(--text3);

  white-space:nowrap
}

.speed-val{
  font-size:11px;

  color:var(--leader);

  min-width:32px;

  text-align:right;

  font-family:var(--font-mono);

  font-weight:600
}

input[type=range]{
  flex:1;

  accent-color:var(--leader);

  cursor:pointer;

  height:4px
}

/* =========================================================
   STATS CARDS
   ========================================================= */

.stats-4{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:7px;

  margin-bottom:9px
}

.stat-card{
  background:var(--bg3);

  border:1px solid var(--border);

  border-radius:8px;

  padding:9px 11px;

  border-top:3px solid
}

.stat-card.c-amber{
  border-top-color:var(--amber);

  background:var(--amber-light)
}

.stat-card.c-coral{
  border-top-color:var(--coral);

  background:var(--coral-light)
}

.stat-card.c-teal{
  border-top-color:var(--follower);

  background:var(--follower-light)
}

.stat-card.c-purple{
  border-top-color:var(--leader-mid);

  background:var(--leader-light)
}

.sc-val{
  font-size:20px;

  font-weight:700;

  font-family:var(--font-mono);

  line-height:1
}

.sc-lbl{
  font-size:9px;

  text-transform:uppercase;

  letter-spacing:0.07em;

  margin-top:3px;

  font-weight:600
}

.stat-card.c-amber .sc-val{
  color:var(--amber)
}

.stat-card.c-amber .sc-lbl{
  color:#7A5309
}

.stat-card.c-coral .sc-val{
  color:var(--coral)
}

.stat-card.c-coral .sc-lbl{
  color:#8A3A1A
}

.stat-card.c-teal .sc-val{
  color:var(--follower)
}

.stat-card.c-teal .sc-lbl{
  color:#4A1D9E
}

.stat-card.c-purple .sc-val{
  color:var(--leader)
}

.stat-card.c-purple .sc-lbl{
  color:#0A5453
}

.progress-rows{
  display:flex;

  flex-direction:column;

  gap:7px
}

.prog-row{
  display:flex;

  align-items:center;

  gap:8px;

  font-size:10px;

  color:var(--text3)
}

.prog-row span:last-child{
  min-width:34px;

  text-align:right;

  font-family:var(--font-mono);

  color:var(--text2);

  font-weight:500
}

.prog-track{
  flex:1;

  height:5px;

  background:var(--bg4);

  border-radius:3px;

  overflow:hidden
}

.prog-fill{
  height:100%;

  border-radius:3px;

  transition:width 0.4s
}

.prog-fill.teal{
  background:var(--follower)
}

.prog-fill.purple{
  background:var(--leader-mid)
}

/* =========================================================
   ROBOT LIST
   ========================================================= */

.robot-row{
  display:flex;

  align-items:center;

  gap:8px;

  padding:6px 0;

  border-bottom:1px solid var(--border)
}

.robot-row:last-child{
  border-bottom:none
}

.rr-icon{
  width:27px;
  height:27px;

  border-radius:50%;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:9px;

  font-weight:700;

  flex-shrink:0
}

.rr-icon.ldr{
  background:var(--leader);

  color:#fff
}

.rr-icon.ind{
  background:var(--amber);

  color:#fff
}

.rr-icon.done{
  background:var(--follower);

  color:#fff
}

.rr-info{
  flex:1;

  min-width:0
}

.rr-name{
  font-size:11px;

  font-weight:600;

  font-family:var(--font-mono);

  color:var(--text)
}

.rr-pos{
  font-size:10px;

  color:var(--text3)
}

.rr-badge{
  font-size:9px;

  padding:1px 7px;

  border-radius:4px;

  font-family:var(--font-mono);

  font-weight:700
}

.badge-leader{
  background:var(--leader-light);

  color:var(--leader);

  border:1px solid rgba(14,124,123,0.3)
}

.badge-indep{
  background:var(--amber-light);

  color:var(--amber);

  border:1px solid rgba(201,138,18,0.3)
}

.badge-done{
  background:var(--follower-light);

  color:var(--follower);

  border:1px solid rgba(109,40,217,0.3)
}

/* =========================================================
   MATRICES
   ========================================================= */

.wb-matrix-wrap{
  overflow:auto;

  margin-bottom:9px
}

.wb-matrix{
  border-collapse:collapse;

  font-family:var(--font-mono);

  font-size:11px;

  width:100%
}

.wb-matrix th,
.wb-matrix td{
  border:1px solid var(--border);

  text-align:center;

  padding:4px 3px;

  min-width:27px;

  transition:background 0.3s
}

.wb-matrix th{
  background:var(--bg3);

  color:var(--text3);

  font-weight:600;

  font-size:9px
}

.wb-matrix td{
  background:var(--bg2);

  color:var(--text2)
}

.wm-unvis{
  color:var(--text4)
}

.wm-target{
  background:var(--target-light);

  color:var(--target);

  font-weight:700
}

.wm-leader{
  background:var(--leader-light);

  color:var(--leader);

  font-weight:700
}

.wm-low{
  background:#E8F0FB;

  color:#185FA5
}

.wm-mid{
  background:var(--leader-light);

  color:var(--leader)
}

.wm-high{
  background:var(--follower-light);

  color:var(--follower)
}

.wb-legend{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:4px
}

.wbl-item{
  display:flex;

  align-items:center;

  gap:5px;

  font-size:10px;

  color:var(--text3)
}

.wbl-dot{
  width:8px;
  height:8px;

  border-radius:50%;

  flex-shrink:0
}

/* =========================================================
   LEGEND
   ========================================================= */

.legend-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:9px
}

.leg-item{
  display:flex;

  align-items:center;

  gap:8px
}

.leg-robot{
  width:28px;
  height:28px;

  border-radius:50%;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:10px;

  font-weight:700;

  color:#fff;

  flex-shrink:0
}

.leg-robot.leader-r{
  background:var(--leader)
}

.leg-robot.indep-r{
  background:var(--amber)
}

.leg-robot.target-r{
  background:var(--target)
}

.leg-cell{
  width:28px;
  height:28px;

  border-radius:5px;

  flex-shrink:0;

  border:1px solid
}

.leg-cell.visited-c{
  background:#EAF0F7;

  border-color:var(--border2)
}

.leg-cell.stuck-c{
  background:var(--coral-light);

  border-color:var(--coral)
}

.leg-cell.unvisited-c{
  background:var(--bg2);

  border-color:var(--border)
}

.leg-name{
  font-size:11px;

  font-weight:500;

  line-height:1.3;

  color:var(--text)
}

.leg-desc{
  font-size:9px;

  color:var(--text3)
}

/* =========================================================
   REPLAY
   ========================================================= */

.replay-label{
  font-size:11px;

  color:var(--text2);

  white-space:nowrap;

  font-family:var(--font-mono)
}

.replay-pos{
  font-size:11px;

  font-family:var(--font-mono);

  color:var(--text2);

  min-width:70px;

  font-weight:500
}

/* =========================================================
   DONE OVERLAY
   ========================================================= */

.done-overlay{
  display:none;

  position:fixed;

  inset:0;

  background:rgba(26,29,46,0.5);

  z-index:80;

  align-items:center;
  justify-content:center;

  backdrop-filter:blur(12px)
}

.done-overlay.show{
  display:flex;

  animation:fade-in 0.45s ease
}

@keyframes fade-in{
  from{
    opacity:0;

    transform:scale(0.96)
  }

  to{
    opacity:1;

    transform:scale(1)
  }
}

.done-card{
  background:var(--bg2);

  border:1.5px solid var(--border2);

  border-radius:24px;

  padding:0;

  display:flex;

  flex-direction:column;

  align-items:stretch;

  min-width:460px;

  max-width:520px;

  box-shadow:
    0 24px 64px rgba(14,124,123,0.22),
    0 4px 16px rgba(14,124,123,0.1);

  overflow:hidden;

  position:relative;

  max-height:92vh;

  overflow-y:auto
}

.done-card::before{
  content:'';

  position:absolute;

  top:0;
  left:0;
  right:0;

  height:4px;

  background:
    linear-gradient(
      90deg,
      #0E7C7B,
      #6D28D9,
      #3F7D20,
      #C98A12,
      #D6455D
    )
}

.done-header{
  display:flex;

  flex-direction:column;

  align-items:center;

  padding:28px 40px 20px;

  gap:8px;

  background:
    linear-gradient(
      180deg,
      #F7FAFB 0%,
      #FFFFFF 100%
    );

  border-bottom:1px solid var(--border)
}

.done-icon-ring{
  width:60px;
  height:60px;

  border-radius:50%;

  background:var(--follower-light);

  border:2.5px solid var(--follower);

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:24px;

  color:var(--follower);

  box-shadow:
    0 4px 16px rgba(109,40,217,0.2)
}

.done-title{
  font-size:20px;

  font-weight:700;

  color:var(--green);

  letter-spacing:-0.01em
}

.done-meta{
  font-size:11px;

  color:var(--text3);

  font-family:var(--font-mono);

  background:var(--bg3);

  padding:4px 14px;

  border-radius:20px;

  border:1px solid var(--border)
}

.done-total-block{
  display:flex;

  flex-direction:column;

  align-items:center;
  justify-content:center;

  padding:22px 24px 18px;

  border-bottom:1px solid var(--border);

  background:var(--leader-light);

  position:relative
}

.done-total-block::before{
  content:'TOTAL COMPUTATION CYCLES';

  position:absolute;

  top:10px;
  left:50%;

  transform:translateX(-50%);

  font-size:9px;

  font-weight:700;

  letter-spacing:0.14em;

  color:var(--leader);

  font-family:var(--font-mono);

  white-space:nowrap
}

.done-total-val{
  font-size:56px;

  font-weight:700;

  font-family:var(--font-mono);

  color:var(--leader);

  line-height:1;

  margin-top:14px
}

.done-total-note{
  font-size:10px;

  color:var(--leader-mid);

  margin-top:4px;

  font-family:var(--font-mono)
}

/* =========================================================
   VISIT DISTRIBUTION
   ========================================================= */

.done-vd-block{
  padding:16px 24px 18px;

  border-bottom:1px solid var(--border);

  background:var(--bg2)
}

.done-vd-label{
  font-size:9px;

  font-weight:700;

  letter-spacing:0.12em;

  text-transform:uppercase;

  color:var(--text3);

  margin-bottom:10px;

  font-family:var(--font-mono)
}

.done-vd-grid{
  display:grid;

  grid-template-columns:repeat(4,1fr);

  gap:7px
}

.done-vd-cell{
  background:var(--bg3);

  border:1px solid var(--border);

  border-radius:8px;

  padding:9px 6px;

  text-align:center;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  gap:3px
}

.done-vd-val{
  font-size:18px;

  font-weight:700;

  font-family:var(--font-mono);

  line-height:1;

  color:var(--leader)
}

.done-vd-lbl{
  font-size:8px;

  text-transform:uppercase;

  letter-spacing:0.05em;

  margin-top:2px;

  color:var(--text3);

  font-weight:600
}

/* =========================================================
   ROBOT CYCLES TABLE
   ========================================================= */

.done-robot-block{
  padding:16px 24px;

  border-bottom:1px solid var(--border)
}

.done-robot-label{
  font-size:9px;

  font-weight:700;

  letter-spacing:0.12em;

  text-transform:uppercase;

  color:var(--text3);

  margin-bottom:10px;

  font-family:var(--font-mono)
}

.robot-cycles-table{
  width:100%;

  border-collapse:collapse;

  font-family:var(--font-mono);

  font-size:11px
}

.robot-cycles-table th{
  font-size:9px;

  color:var(--text3);

  font-weight:700;

  letter-spacing:0.08em;

  text-transform:uppercase;

  padding:4px 6px;

  text-align:left;

  border-bottom:1.5px solid var(--border2)
}

.robot-cycles-table th:not(:first-child){
  text-align:center
}

.robot-cycles-table td{
  padding:7px 6px;

  border-bottom:1px solid var(--border);

  color:var(--text2);

  vertical-align:middle
}

.robot-cycles-table td:not(:first-child){
  text-align:center
}

.robot-cycles-table tr:last-child td{
  border-bottom:none
}

.rct-id{
  display:flex;

  align-items:center;

  gap:7px
}

.rct-dot{
  width:22px;
  height:22px;

  border-radius:50%;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:9px;

  font-weight:700;

  color:#fff;

  flex-shrink:0
}

.rct-dot.ldr{
  background:var(--leader)
}

.rct-dot.ind{
  background:var(--amber)
}

.rct-val-main{
  font-size:13px;

  font-weight:700;

  color:var(--leader)
}

.rct-val-sub{
  font-size:11px;

  color:var(--text3)
}

.rct-val-back{
  font-size:11px;

  color:var(--coral);

  font-weight:600
}

.done-actions{
  display:flex;

  gap:10px;

  padding:16px 24px;

  background:var(--bg2)
}

.done-actions .btn{
  flex:1;

  padding:11px 0;

  font-size:13px
}

/* =========================================================
   TOAST
   ========================================================= */

#toast-container{
  position:fixed;

  bottom:22px;
  left:50%;

  transform:translateX(-50%);

  display:flex;

  flex-direction:column;

  gap:8px;

  z-index:200;

  pointer-events:none
}

.toast{
  padding:8px 20px;

  border-radius:20px;

  font-size:12px;

  font-weight:500;

  opacity:0;

  transform:translateY(6px);

  transition:all 0.25s;

  pointer-events:none;

  white-space:nowrap;

  box-shadow:var(--shadow-md)
}

.toast.show{
  opacity:1;

  transform:translateY(0)
}

.toast-info{
  background:var(--leader-light);

  color:var(--leader);

  border:1px solid rgba(14,124,123,0.3)
}

.toast-success{
  background:var(--green-light);

  color:var(--green);

  border:1px solid rgba(63,125,32,0.3)
}

.toast-error{
  background:var(--target-light);

  color:var(--target);

  border:1px solid rgba(214,69,93,0.3)
}

/* =========================================================
   SCROLLBAR / FOCUS
   ========================================================= */

::-webkit-scrollbar{
  width:5px;
  height:5px
}

::-webkit-scrollbar-track{
  background:var(--bg3)
}

::-webkit-scrollbar-thumb{
  background:var(--border3);

  border-radius:3px
}

::-webkit-scrollbar-thumb:hover{
  background:var(--leader-mid)
}

button:focus-visible{
  outline:2px solid var(--leader);

  outline-offset:2px;

  box-shadow:
    0 0 0 4px var(--leader-glow)
}
</style>
</head>

