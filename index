/* =========================================================
   ELECTION
   ========================================================= */

function renderElection(s){

  const panel=
    document.getElementById(
      'election-panel'
    );

  const statusText=
    document.getElementById(
      'election-status-text'
    );

  const candWrap=
    document.getElementById(
      'election-candidates'
    );

  const winnerLine=
    document.getElementById(
      'election-winner-line'
    );


  if(!panel){
    return;
  }


  const contending=
    s.election_contenders>0;


  panel.classList.toggle(
    'active',
    contending
  );


  panel.classList.toggle(
    'decided',
    !!s.leader_id
  );


  if(s.leader_id){

    statusText.textContent=
      'Election resolved';


    candWrap.innerHTML=`

      <span class="election-chip">

        <span class="chip-id">
          ${s.leader_id.replace('R','')}
        </span>

        ${s.leader_id} — LEADER

      </span>

    `;


    winnerLine.textContent=
      'Smallest robot ID wins the concurrent-write election.';

  }else if(contending){

    statusText.textContent=
      `Election in progress — ${s.election_contenders}`;


    const ids=
      s.election_candidate_ids
      ||
      [];


    candWrap.innerHTML=
      ids.map(c=>{

        const isSmallest=
          ids.length>0
          &&
          c.rid_num===
          Math.min(
            ...ids.map(
              x=>x.rid_num
            )
          );


        return `

          <span
            class="election-chip"
            title="ID ${c.rid_num}${isSmallest?' — currently smallest, will win':''}"
          >

            <span class="chip-id">
              ${c.rid_num}
            </span>

            ${c.id}

            ${isSmallest?' ★':''}

          </span>

        `;

      }).join('');


    winnerLine.textContent='';

  }else{

    statusText.textContent=
      'Waiting for robots to reach target';


    candWrap.innerHTML=
      `
        <span class="election-empty">
          No robots on the target yet…
        </span>
      `;


    winnerLine.textContent='';

  }

}


/* =========================================================
   ROBOT LIST
   ========================================================= */

function renderRobotList(s){

  const list=
    document.getElementById(
      'robot-status-list'
    );


  if(!list){
    return;
  }


  list.innerHTML='';


  for(const ro of s.robots){

    const atTarget=
      ro.pos[0]===s.target[0]
      &&
      ro.pos[1]===s.target[1];


    const visitsHere=
      (
        s.visit_count
        &&
        s.visit_count[ro.pos[0]]
        &&
        s.visit_count[ro.pos[0]][ro.pos[1]]
      )
      ||
      0;


    const row=
      document.createElement('div');

    row.className=
      'robot-row';


    const iconCls=
      ro.is_leader
      ?
      'ldr'
      :
      atTarget
      ?
      'done'
      :
      'ind';


    const badge=

      ro.is_leader

      ?

      '<span class="rr-badge badge-leader">LEADER</span>'

      :

      atTarget

      ?

      '<span class="rr-badge badge-done">AT TARGET</span>'

      :

      '<span class="rr-badge badge-indep">INDEPENDENT</span>';


    row.innerHTML=`

      <div class="rr-icon ${iconCls}">
        ${ro.id.replace('R','')}
      </div>

      <div class="rr-info">

        <div class="rr-name">
          ${ro.id} ${badge}
        </div>

        <div class="rr-pos">

          pos(${ro.pos[0]},${ro.pos[1]})
          wb=${ro.wb_current>=0?ro.wb_current:'—'}
          moves=${ro.steps_taken}
          visits(here)=${visitsHere}

        </div>

      </div>

    `;


    list.appendChild(row);

  }

}


/* =========================================================
   WB MATRIX
   ========================================================= */

function renderWBMatrix(s){

  const t=
    document.getElementById(
      'wb-matrix'
    );


  if(!t){
    return;
  }


  const flatWb=
    s.wb
      .flat()
      .filter(
        v=>v>=0
      );


  const wbMax=
    flatWb.length
    ?
    Math.max(...flatWb)
    :
    1;


  let h=
    '<tr><th></th>';


  for(
    let c=0;
    c<s.cols;
    c++
  ){

    h+=`
      <th>
        c${c}
      </th>
    `;

  }


  h+='</tr>';


  for(
    let r=0;
    r<s.rows;
    r++
  ){

    h+=`
      <tr>
        <th>r${r}</th>
    `;


    for(
      let c=0;
      c<s.cols;
      c++
    ){

      const v=
        s.wb[r][c];


      const isT=
        r===s.target[0]
        &&
        c===s.target[1];


      const isL=
        s.leader_pos
        &&
        r===s.leader_pos[0]
        &&
        c===s.leader_pos[1];


      let cls=
        'wm-unvis';


      if(isT){

        cls=
          'wm-target';

      }else if(isL){

        cls=
          'wm-leader';

      }else if(v>=0){

        const ratio=
          v/wbMax;


        cls=
          ratio<0.33
          ?
          'wm-low'
          :
          ratio<0.66
          ?
          'wm-mid'
          :
          'wm-high';

      }


      h+=`
        <td class="${cls}">
          ${v>=0?v:'—'}
        </td>
      `;

    }


    h+='</tr>';

  }


  t.innerHTML=h;

}


/* =========================================================
   VISIT MATRIX
   ========================================================= */

function renderVisitMatrix(s){

  const t=
    document.getElementById(
      'visit-matrix'
    );


  if(!t){
    return;
  }


  const vc=
    s.visit_count;


  if(!vc){
    return;
  }


  const vmax=
    s.visit_max
    ||
    1;


  let h=
    '<tr><th></th>';


  for(
    let c=0;
    c<s.cols;
    c++
  ){

    h+=`
      <th>
        c${c}
      </th>
    `;

  }


  h+='</tr>';


  for(
    let r=0;
    r<s.rows;
    r++
  ){

    h+=`
      <tr>
        <th>r${r}</th>
    `;


    for(
      let c=0;
      c<s.cols;
      c++
    ){

      const v=
        vc[r][c]
        ||
        0;


      let cls=
        'wm-unvis';


      if(v>0){

        const ratio=
          v/vmax;


        cls=
          ratio<0.33
          ?
          'wm-low'
          :
          ratio<0.66
          ?
          'wm-mid'
          :
          'wm-high';

      }


      h+=`
        <td class="${cls}">
          ${v||'—'}
        </td>
      `;

    }


    h+='</tr>';

  }


  t.innerHTML=h;

}


