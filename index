/* =========================================================
   RUN ALL
   ========================================================= */

async function doRunAll(){

  stopPlay();

  showToast(
    'Computing all steps...',
    'info'
  );

  const data=await api(
    '/api/run_all',
    'POST',
    {
      rows:RG.rows,
      cols:RG.cols
    }
  );

  if(!data){
    return;
  }

  RG.replay=data.steps;

  RG.replayIdx=0;

  RG.replayMode=true;

  RG.state=RG.replay[0];

  render(RG.state);

  updateControls();


  const bar=
    document.getElementById('replay-bar');

  bar.classList.add('show');


  const sl=
    document.getElementById(
      'replay-slider'
    );

  sl.max=data.total-1;

  sl.value=0;


  document.getElementById(
    'replay-pos'
  ).textContent=
    `0 / ${data.total-1}`;


  showToast(
    `${data.total} steps loaded`,
    'success'
  );

}


/* =========================================================
   REPLAY
   ========================================================= */

function replayNext(){

  if(
    RG.replayIdx <
    RG.replay.length-1
  ){

    RG.replayIdx++;

    RG.state=
      RG.replay[RG.replayIdx];

    render(RG.state);


    const sl=
      document.getElementById(
        'replay-slider'
      );

    sl.value=RG.replayIdx;


    document.getElementById(
      'replay-pos'
    ).textContent=
      `${RG.replayIdx} / ${RG.replay.length-1}`;
  }

}


function replayPrev(){

  if(RG.replayIdx>0){

    RG.replayIdx--;

    RG.state=
      RG.replay[RG.replayIdx];

    render(RG.state);


    const sl=
      document.getElementById(
        'replay-slider'
      );

    sl.value=RG.replayIdx;


    document.getElementById(
      'replay-pos'
    ).textContent=
      `${RG.replayIdx} / ${RG.replay.length-1}`;
  }

}


function replaySeek(v){

  RG.replayIdx=parseInt(v,10);

  RG.state=
    RG.replay[RG.replayIdx];

  render(RG.state);


  document.getElementById(
    'replay-pos'
  ).textContent=
    `${RG.replayIdx} / ${RG.replay.length-1}`;

}


function exitReplay(){

  RG.replayMode=false;

  RG.replay=[];

  RG.replayIdx=0;

  document
    .getElementById('replay-bar')
    .classList.remove('show');

  doReset();

}
function setGridCellSize(rows, cols){

  let size = 72;

  // Small grids
  if(rows <= 8 && cols <= 10){
    size = 72;
  }

  // Medium grids
  else if(rows <= 15 && cols <= 25){
    size = 50;
  }

  // 25x25 type grids
  else if(rows <= 25 && cols <= 25){
    size = 38;
  }

  // 25x50 / 50x25
  else if(rows <= 25 && cols <= 50){
    size = 30;
  }

  // 50x50
  else if(rows <= 50 && cols <= 50){
    size = 22;
  }

  // Larger grids
  else{
    size = 20;
  }

  document.documentElement.style.setProperty(
    '--cell',
    `${size}px`
  );
}

/* =========================================================
   GRID BUILD
   ========================================================= */

function buildGrid(rows,cols){

  RG.rows=rows;

  RG.cols=cols;


  const grid=
    document.getElementById('grid');

  grid.style.setProperty(
    '--cols',
    cols
  );

  grid.innerHTML='';


  const colLabels=
    document.getElementById('col-labels');

  const rowLabels=
    document.getElementById('row-labels');


  colLabels.innerHTML='';

  rowLabels.innerHTML='';


  for(
    let c=0;
    c<cols;
    c++
  ){

    const d=
      document.createElement('div');

    d.className='col-label';

    d.textContent=`c${c}`;

    colLabels.appendChild(d);
  }


  for(
    let r=0;
    r<rows;
    r++
  ){

    const d=
      document.createElement('div');

    d.className='row-label';

    d.textContent=`r${r}`;

    rowLabels.appendChild(d);
  }


  for(
    let r=0;
    r<rows;
    r++
  ){

    for(
      let c=0;
      c<cols;
      c++
    ){

      const cell=
        document.createElement('div');

      cell.className='cell';

      cell.id=
        `cell-${r}-${c}`;


      cell.innerHTML=`

        <div
          class="wb-num"
          id="wb-${r}-${c}"
        ></div>

        <div
          class="visit-badge"
          id="vb-${r}-${c}"
        ></div>

        <div
          class="cell-content"
          id="ct-${r}-${c}"
        ></div>

        <div class="cell-coord">
          (${r},${c})
        </div>

      `;


      grid.appendChild(cell);
    }
  }

}


/* =========================================================
   RENDER
   ========================================================= */

function render(s){

  if(!s){
    return;
  }


  if(
    s.rows!==RG.rows
    ||
    s.cols!==RG.cols
  ){

    buildGrid(
      s.rows,
      s.cols
    );

  }


  renderCells(s);

  renderPhase(s);

  renderStats(s);

  renderElection(s);

  renderRobotList(s);

  renderWBMatrix(s);

  renderVisitMatrix(s);

  renderEventBanner(s);


  if(s.leader_flash){

    triggerLeaderFlash();
  }


  if(s.phase==='DONE'){

    triggerDone(s);
  }


  RG.prevWb=
    s.wb.map(
      r=>[...r]
    );

}


/* =========================================================
   RENDER CELLS
   ========================================================= */

function renderCells(s){

  const posMap={};


  for(const ro of s.robots){

    const k=
      `${ro.pos[0]},${ro.pos[1]}`;

    if(!posMap[k]){
      posMap[k]=[];
    }

    posMap[k].push(ro);
  }


  const hlSet=
    new Set(
      (s.highlight_cells||[])
      .map(
        p=>`${p[0]},${p[1]}`
      )
    );


  const electing=
    s.election_contenders>0;


  for(
    let r=0;
    r<s.rows;
    r++
  ){

    for(
      let c=0;
      c<s.cols;
      c++
    ){

      const cell=
        document.getElementById(
          `cell-${r}-${c}`
        );

      const wbEl=
        document.getElementById(
          `wb-${r}-${c}`
        );

      const vbEl=
        document.getElementById(
          `vb-${r}-${c}`
        );

      const ct=
        document.getElementById(
          `ct-${r}-${c}`
        );


      if(!cell){
        continue;
      }


      const wb=s.wb[r][c];


      const isT=
        r===s.target[0]
        &&
        c===s.target[1];


      const isLeaderCell=
        s.leader_pos
        &&
        r===s.leader_pos[0]
        &&
        c===s.leader_pos[1];


      const isHl=
        hlSet.has(`${r},${c}`);


      const prevWb=
        RG.prevWb
        ?
        RG.prevWb[r][c]
        :
        -1;


      cell.className='cell';


      if(isT){

        cell.classList.add(
          'c-target'
        );

      }else if(
        isLeaderCell
        &&
        s.last_action==='BACKTRACK'
      ){

        cell.classList.add(
          'c-stuck'
        );

      }else if(isLeaderCell){

        cell.classList.add(
          'c-leader'
        );

      }else if(wb>=0){

        cell.classList.add(
          'c-visited'
        );
      }


      if(
        isHl
        &&
        !isT
      ){

        cell.classList.add(
          'c-highlight'
        );
      }


      if(
        wb!==prevWb
        &&
        wb>0
        &&
        !isT
      ){

        const fc=
          s.last_action==='BACKTRACK'
          ?
          'flash-back'
          :
          'flash-fwd';


        cell.classList.remove(fc);


        void cell.offsetWidth;


        cell.classList.add(fc);


        setTimeout(
          ()=>{
            cell.classList.remove(fc);
          },
          700
        );

      }


      if(wb>=0){

        const pv=
          (
            s.wb_parent
            &&
            s.wb_parent[r]
            &&
            s.wb_parent[r][c]!==undefined
          )
          ?
          s.wb_parent[r][c]
          :
          -1;


        wbEl.innerHTML=

          pv>=0

          ?

          `<span>${wb}</span>
           <span
             class="wb-parent-tag"
             title="WBparent_no — parent node's WBnode_no"
           >
             P:${pv}
           </span>`

          :

          `<span>${wb}</span>`;

      }else{

        wbEl.textContent='';

      }


      if(vbEl){

        const vc=
          (
            s.visit_count
            &&
            s.visit_count[r]
            &&
            s.visit_count[r][c]
          )
          ||
          0;


        vbEl.textContent=
          vc>0
          ?
          `v${vc}`
          :
          '';


        vbEl.className=
          'visit-badge'
          +
          (
            vc>1
            ?
            ' multi-visit'
            :
            ''
          );

      }


      /* Election badge */

      let badge=
        cell.querySelector(
          '.election-badge'
        );


      if(
        isT
        &&
        electing
      ){

        if(!badge){

          badge=
            document.createElement('div');

          badge.className=
            'election-badge';

          cell.appendChild(badge);

        }


        badge.textContent=
          `⚡ ${s.election_contenders}`;


        badge.title=
          `Leader election in progress — ${s.election_contenders} robot(s) contesting for smallest ID`;

      }else if(badge){

        badge.remove();

      }


      ct.innerHTML='';


      const robs=
        posMap[`${r},${c}`]
        ||
        [];


      if(
        robs.length===0
        &&
        isT
      ){

        const w=
          document.createElement('div');

        w.className=
          'robot-icon anim-target';

        w.innerHTML=
          svgTarget();

        ct.appendChild(w);

      }


      for(const ro of robs){

        const wrap=
          document.createElement('div');

        wrap.className=
          'robot-wrap anim-pop';


        const icon=
          document.createElement('div');

        icon.className=
          'robot-icon';


        const sub=
          document.createElement('div');

        sub.className=
          'robot-sub';


        if(ro.is_leader){

          icon.innerHTML=
            svgLeader();

          icon.classList.add(
            'anim-leader'
          );

          sub.textContent=
            'LEADER';

          sub.style.color=
            'var(--leader)';

        }else if(
          ro.pos[0]===s.target[0]
          &&
          ro.pos[1]===s.target[1]
        ){

          icon.innerHTML=
            svgDone();

          sub.textContent=
            ro.id;

          sub.style.color=
            'var(--follower)';

        }else{

          icon.innerHTML=
            svgRobot();

          sub.textContent=
            ro.id;

        }


        wrap.appendChild(icon);

        wrap.appendChild(sub);

        ct.appendChild(wrap);

      }

    }

  }

}


/* =========================================================
   PHASE
   ========================================================= */

function renderPhase(s){

  const PCFG={

    INIT:{
      label:'INIT',
      color:'#7880AA',
      bg:'#F4F6FA'
    },

    RUNNING:{
      label:'EXPLORE',
      color:'#0E7C7B',
      bg:'#E3F6F5'
    },

    BACKTRACK:{
      label:'BACKTRACK',
      color:'#E2653A',
      bg:'#FCEEE6'
    },

    DONE:{
      label:'DONE — ALL GATHERED',
      color:'#3F7D20',
      bg:'#EDF6E3'
    }

  };


  const key=
    s.last_action==='BACKTRACK'
    ?
    'BACKTRACK'
    :
    s.phase==='DONE'
    ?
    'DONE'
    :
    'RUNNING';


  const cfg=
    PCFG[key]
    ||
    PCFG.RUNNING;


  const badge=
    document.getElementById(
      'phase-badge'
    );

  const dot=
    document.getElementById(
      'phase-dot'
    );

  const txt=
    document.getElementById(
      'phase-text'
    );


  badge.style.background=
    cfg.bg;

  badge.style.color=
    cfg.color;

  badge.style.borderColor=
    cfg.color+'44';

  dot.style.background=
    cfg.color;

  txt.textContent=
    cfg.label;


  const tag=
    document.getElementById(
      'case-tag'
    );


  if(tag){

    if(s.election_contenders>0){

      tag.textContent=
        `⚡ Election: ${s.election_contenders}`;

    }else if(s.leader_id){

      tag.textContent=
        `Leader ${s.leader_id} exploring`;

    }else{

      tag.textContent=
        `${s.rows}×${s.cols} · ${s.total_robots} robots`;

    }

  }

}


