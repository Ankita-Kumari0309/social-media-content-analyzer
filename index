   API
   ========================================================= */

async function api(
  url,
  method='GET',
  body=null
){

  const opts={
    method,
    headers:{
      'Content-Type':'application/json'
    }
  };

  if(body){
    opts.body=JSON.stringify(body);
  }

  try{

    const r=await fetch(url,opts);

    if(!r.ok){

      let e={};

      try{
        e=await r.json();
      }catch(_){}

      showToast(
        e.error || 'Error',
        'error'
      );

      return null;
    }

    return await r.json();

  }catch(e){

    console.error(e);

    showToast(
      'Network error',
      'error'
    );

    return null;
  }

}


/* =========================================================
   STEP
   ========================================================= */

async function doStep(){

  if(RG.replayMode){

    replayNext();

    return;
  }

  if(RG.state?.phase==='DONE'){

    return;
  }

  const s=await api(
    '/api/step',
    'POST'
  );

  if(s){

    RG.state=s;

    render(s);

    updateControls();
  }

}


/* =========================================================
   PLAY
   ========================================================= */

function togglePlay(){

  if(
    RG.state?.phase==='DONE'
    &&
    !RG.replayMode
  ){
    return;
  }

  RG.playing=!RG.playing;

  const btn=
    document.getElementById('btn-play');

  const lbl=
    document.getElementById('play-label');

  const ico=
    document.getElementById('play-icon');


  if(RG.playing){

    btn.classList.add('active');

    lbl.textContent='Pause';

    ico.innerHTML=`
      <rect
        x="3"
        y="2"
        width="2.5"
        height="8"
        fill="currentColor"
      />

      <rect
        x="6.5"
        y="2"
        width="2.5"
        height="8"
        fill="currentColor"
      />
    `;

    scheduleNext();

  }else{

    stopPlay();

  }

}


function scheduleNext(){

  if(!RG.playing){
    return;
  }

  RG.timer=setTimeout(
    async()=>{

      await doStep();

      if(
        RG.state?.phase==='DONE'
        &&
        !RG.replayMode
      ){

        stopPlay();

        return;
      }

      scheduleNext();

    },

    1000/RG.speed
  );

}


function stopPlay(){

  RG.playing=false;

  clearTimeout(RG.timer);

  const btn=
    document.getElementById('btn-play');

  const lbl=
    document.getElementById('play-label');

  const ico=
    document.getElementById('play-icon');

  if(btn){
    btn.classList.remove('active');
  }

  if(lbl){
    lbl.textContent='Play';
  }

  if(ico){

    ico.innerHTML=`
      <polygon
        points="3,2 10,6 3,10"
        fill="currentColor"
      />
    `;
  }

}


/* =========================================================
   SPEED
   ========================================================= */

function setSpeed(v){

  RG.speed=parseInt(v,10);

  document.getElementById(
    'speed-val'
  ).textContent=v+'/s';

  if(RG.playing){

    clearTimeout(RG.timer);

    scheduleNext();
  }

}


/* =========================================================
   RESET
   ========================================================= */

async function doReset(config={}){

  stopPlay();

  RG.replayMode=false;

  RG.replay=[];

  RG.replayIdx=0;

  RG.prevWb=null;

  document
    .getElementById('done-overlay')
    .classList.remove('show');

  document
    .getElementById('replay-bar')
    .classList.remove('show');


  const s=await api(
    '/api/reset',
    'POST',
    config
  );


  if(s){

    RG.state=s;

    RG.rows=s.rows;

    RG.cols=s.cols;

    buildGrid(
      s.rows,
      s.cols
    );

    render(s);

    updateControls();

    syncConfigFromState(s);
  }

}


