/* =========================================================
   CONTROL STATE
   ========================================================= */

function updateControls(){

  const s=
    RG.state;


  if(!s){
    return;
  }


  const done=
    s.phase==='DONE';


  const stepBtn=
    document.getElementById(
      'btn-step'
    );


  const undoBtn=
    document.getElementById(
      'btn-undo'
    );


  if(stepBtn){

    stepBtn.disabled=
      done
      &&
      !RG.replayMode;

  }


  if(undoBtn){

    undoBtn.disabled=
      !s.can_undo
      ||
      RG.replayMode;

  }

}


/* =========================================================
   CONFIGURATION UI
   ========================================================= */

function toggleConfig(){

  document
    .getElementById('cfg-drawer')
    .classList.toggle('open');

  document
    .getElementById('cfg-overlay')
    .classList.toggle('show');

}


function closeConfig(){

  document
    .getElementById('cfg-drawer')
    .classList.remove('open');

  document
    .getElementById('cfg-overlay')
    .classList.remove('show');

}


/* =========================================================
   PARSE GRID SIZE
   ========================================================= */

function parseGridSize(){

  const value=
    (
      document
        .getElementById('cfg-grid-size')
        ?.value
      ||
      ''
    )
    .trim()
    .toLowerCase();


  /*
    Accepts:

    25x25
    15x25
    15 x 25
    15X50
  */

  const match=
    value.match(
      /^(\d+)\s*x\s*(\d+)$/
    );


  if(!match){

    showToast(
      'Enter grid size as rows x columns, e.g. 25x25',
      'error'
    );

    return null;
  }


  const rows=
    parseInt(
      match[1],
      10
    );


  const cols=
    parseInt(
      match[2],
      10
    );


  if(
    !Number.isInteger(rows)
    ||
    !Number.isInteger(cols)
    ||
    rows<1
    ||
    cols<1
  ){

    showToast(
      'Grid dimensions must be at least 1',
      'error'
    );

    return null;
  }


  return {
    rows,
    cols
  };

}


/* =========================================================
   TARGET TYPE
   ========================================================= */

function getSelectedTargetType(){

  const selected=
    document.querySelector(
      'input[name="target-location"]:checked'
    );


  return(
    selected?.value
    ||
    'border'
  );

}


function selectTargetType(radio){

  document
    .querySelectorAll(
      '.cfg-choice'
    )
    .forEach(
      el=>{
        el.classList.remove(
          'selected'
        );
      }
    );


  radio
    ?.closest('.cfg-choice')
    ?.classList.add(
      'selected'
    );

}


/* =========================================================
   ROBOT COUNT
   ========================================================= */

function getConfiguredRobotCount(){

  const count=
    parseInt(
      document
        .getElementById(
          'cfg-robot-count'
        )
        ?.value,
      10
    );


  if(
    !Number.isInteger(count)
    ||
    count<1
  ){

    showToast(
      'Enter a valid number of robots',
      'error'
    );

    return null;
  }


  return count;

}


/* =========================================================
   TRIAL COUNT
   ========================================================= */

function getConfiguredTrials(){

  const trials=
    parseInt(
      document
        .getElementById(
          'cfg-trials'
        )
        ?.value,
      10
    );


  if(
    !Number.isInteger(trials)
    ||
    trials<1
  ){

    showToast(
      'Enter a valid number of trials',
      'error'
    );

    return null;
  }


  return trials;

}


/* =========================================================
   GENERATE CONFIGURATION
   ========================================================= */

function newRandomConfig(){

  const grid=
    parseGridSize();


  if(!grid){
    return;
  }


  const robotCount=
    getConfiguredRobotCount();


  if(robotCount===null){
    return;
  }


  const trials=
    getConfiguredTrials();


  if(trials===null){
    return;
  }


  if(
    robotCount>
    grid.rows*grid.cols
  ){

    showToast(
      'Number of robots cannot exceed total grid cells',
      'error'
    );

    return;
  }


  const targetType=
    getSelectedTargetType();


  /*
    Store the configuration locally.

    The backend will generate:
      - the exact random target
      - random robot positions
      - required target/neighbor anchor
  */

  RG.experimentTrials=
    trials;


  RG.experimentConfig={

    rows:grid.rows,

    cols:grid.cols,

    target_type:targetType,

    num_robots:robotCount,

    trials:trials

  };


  closeConfig();


  /*
    Generate ONE configuration
    and load it into the normal UI.
  */

  doReset({

    rows:grid.rows,

    cols:grid.cols,

    target_type:targetType,

    num_robots:robotCount

  });

}


/* =========================================================
   RUN EXPERIMENT
   ========================================================= */

async function runExperimentFromConfig(){

  const grid=
    parseGridSize();


  if(!grid){
    return;
  }


  const robotCount=
    getConfiguredRobotCount();


  if(robotCount===null){
    return;
  }


  const trials=
    getConfiguredTrials();


  if(trials===null){
    return;
  }


  if(
    robotCount>
    grid.rows*grid.cols
  ){

    showToast(
      'Number of robots cannot exceed total grid cells',
      'error'
    );

    return;
  }


  const targetType=
    getSelectedTargetType();


  RG.experimentTrials=
    trials;


  RG.experimentConfig={

    rows:grid.rows,

    cols:grid.cols,

    target_type:targetType,

    num_robots:robotCount,

    trials:trials

  };


  showToast(
    `Running ${trials} experiment trial${trials===1?'':'s'}...`,
    'info'
  );


  const result=
    await api(
      '/api/run_experiment',
      'POST',
      {

        rows:grid.rows,

        cols:grid.cols,

        target_type:targetType,

        num_robots:robotCount,

        trials:trials

      }
    );


  if(!result){
    return;
  }


  /*
    The experiment-results UI
    will use result.results later.
  */

  if(result.results){

    console.log(
      'Experiment results:',
      result.results
    );

  }

}


/* =========================================================
   SYNC CONFIGURATION WITH STATE
   ========================================================= */

function syncConfigFromState(s){

  if(!s){
    return;
  }


  const targetEl=
    document.getElementById(
      'cfg-target'
    );


  if(targetEl){

    targetEl.value=
      `${s.target[0]},${s.target[1]}`;

  }


  const gridEl=
    document.getElementById(
      'cfg-grid-size'
    );


  if(gridEl){

    gridEl.value=
      `${s.rows}x${s.cols}`;

  }


  const robotEl=
    document.getElementById(
      'cfg-robot-count'
    );


  if(robotEl){

    robotEl.value=
      s.total_robots;

  }


  const trialsEl=
    document.getElementById(
      'cfg-trials'
    );


  if(trialsEl){

    trialsEl.value=
      RG.experimentTrials
      ||
      10;

  }

}


/* =========================================================
   TOAST
   ========================================================= */

function showToast(
  msg,
  type='info'
){

  const t=
    document.createElement('div');


  t.className=
    `toast toast-${type}`;


  t.textContent=
    msg;


  document
    .getElementById(
      'toast-container'
    )
    .appendChild(t);


  setTimeout(
    ()=>{
      t.classList.add('show');
    },
    10
  );


  setTimeout(
    ()=>{

      t.classList.remove(
        'show'
      );


      setTimeout(
        ()=>{
          t.remove();
        },
        300
      );

    },
    3000
  );

}


/* =========================================================
   SET TEXT
   ========================================================= */

function setText(id,v){

  const el=
    document.getElementById(id);


  if(el){

    el.textContent=v;

  }

}


/* =========================================================
   KEYBOARD
   ========================================================= */

document.addEventListener(
  'keydown',
  e=>{

    if(
      e.target.tagName==='INPUT'
      ||
      e.target.tagName==='TEXTAREA'
    ){

      return;
    }


    if(e.key===' '){

      e.preventDefault();

      doStep();

    }


    if(
      e.key==='p'
      ||
      e.key==='P'
    ){

      togglePlay();

    }


    if(
      e.key==='r'
      ||
      e.key==='R'
    ){

      doReset();

    }


    if(
      e.key==='u'
      ||
      e.key==='U'
    ){

      doUndo();

    }


    if(
      e.key==='ArrowRight'
    ){

      if(
        RG.replayMode
      ){

        replayNext();

      }else{

        const sl=
          document.getElementById(
            'speed-slider'
          );


        sl.value=
          Math.min(
            10,
            +sl.value+1
          );


        setSpeed(
          sl.value
        );

      }

    }


    if(
      e.key==='ArrowLeft'
    ){

      if(
        RG.replayMode
      ){

        replayPrev();

      }else{

        const sl=
          document.getElementById(
            'speed-slider'
          );


        sl.value=
          Math.max(
            1,
            +sl.value-1
          );


        setSpeed(
          sl.value
        );

      }

    }

  }
);


/* =========================================================
   INITIAL LOAD
   ========================================================= */

(async()=>{

  const s=
    await api(
      '/api/state'
    );


  if(s){

    RG.state=s;

    RG.rows=s.rows;

    RG.cols=s.cols;


    buildGrid(
      s.rows,
      s.cols
    );


    render(s);

    updateControls();

    syncConfigFromState(s);

  }

})();

</script>

